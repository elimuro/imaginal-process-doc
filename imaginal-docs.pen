                                {
                                  "type": "text",
                                  "id": "eSbt3",
                                  "name": "Title",
                                  "fill": "#F3F1EC",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "A complex score with no system",
                                  "fontFamily": "Neue Brucke",
                                  "fontSize": 26,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "text",
                                  "id": "q7idwa",
                                  "name": "Body",
                                  "fill": "#C8C3BA",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Years of visual material lived in scattered boards and folders. Rich, but unreadable under stage lights. Nothing told the operator what to call next.",
                                  "lineHeight": 1.5,
                                  "fontFamily": "IBM Plex Sans",
                                  "fontSize": 17,
                                  "fontWeight": "normal"
                                }
                              ]
                            }
                          ]
                        },
