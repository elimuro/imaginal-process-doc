                    },
                    {
                      "type": "text",
                      "id": "Pev03",
                      "name": "About body",
                      "fill": "$text-dim",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "We wanted to know what happens when you treat a live show the way an airline treats a flight — with a gate, a boarding pass, a departure time, and a destination no one has been to before.",
                      "lineHeight": "$type-body-sm-lh",
                      "fontFamily": "$font-body",
                      "fontSize": "$type-body-sm",
