                },
                {
                  "type": "text",
                  "id": "KJHts",
                  "name": "Brand Headline",
                  "fill": "$text-dark",
                  "textGrowth": "fixed-width",
                  "width": 900,
                  "content": "The brand came first.",
                  "lineHeight": 0.95,
                  "fontFamily": "$font-display",
                  "fontSize": 80,
                  "fontWeight": "$type-weight-normal"
                },
                {
                  "type": "text",
                  "id": "aI5vg",
                  "name": "Brand Body",
                  "fill": "$text-dim",
                  "textGrowth": "fixed-width",
                  "width": 600,
                  "content": "Before a single visual was triggered or a note was played, we built the world. Imaginal Airlines began as a brand — an airline that doesn’t fly planes but carries passengers into consciousness. Every design decision that followed grew from that metaphor.",
                  "lineHeight": 1.7,
                  "fontFamily": "$font-body",
                  "fontSize": "$type-body-base",
                  "fontWeight": "$type-weight-normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "USshQ",
              "name": "Brand Columns",
              "width": "fill_container",
              "gap": 48,
              "padding": [
                64,
                80,
                80,
                80
              ],
              "children": [
                {
                  "type": "frame",
                  "id": "cTNAY",
                  "name": "THE METAPHOR Column",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "EInPt",
                      "name": "THE METAPHOR Title",
                      "fill": "$text-accent",
                      "content": "THE METAPHOR",
                      "fontFamily": "$font-body",
                      "fontSize": "$type-label-md",
                      "fontWeight": "$type-weight-medium",
                      "letterSpacing": "$type-label-md-ls"
                    },
                    {
                      "type": "text",
                      "id": "lYzWL",
                      "name": "THE METAPHOR Body",
                      "fill": "$text-dim",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "An airline operates on trust — you hand over your agency, follow the ritual of check-in, boarding, and departure, and arrive somewhere new. We built that same arc into a performance.",
                      "lineHeight": "$type-body-sm-lh",
                      "fontFamily": "$font-body",
                      "fontSize": "$type-body-sm",
                      "fontWeight": "$type-weight-normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "J3xnrF",
                  "name": "THE FOUNDATION Column",
                  "width": "fill_container",
                  "layout": "vertical",
