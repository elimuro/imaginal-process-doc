                                  "name": "Body",
                                  "fill": "#C8C3BA",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "The musicians never play the same thing twice. The maestro cannot rely on timecode or a set list — every cue is chosen in response to the room.",
                                  "lineHeight": 1.5,
                                  "fontFamily": "IBM Plex Sans",
                                  "fontSize": 17,
