                  "children": [
                    {
                      "type": "text",
                      "id": "opvZf",
                      "name": "THE FOUNDATION Title",
                      "fill": "$text-accent",
                      "content": "THE FOUNDATION",
                      "fontFamily": "$font-body",
                      "fontSize": "$type-label-md",
                      "fontWeight": "$type-weight-medium",
                      "letterSpacing": "$type-label-md-ls"
                    },
                    {
                      "type": "text",
                      "id": "b675GZ",
                      "name": "THE FOUNDATION Body",
                      "fill": "$text-dim",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Colours, typography, and visual language were locked before the first rehearsal. Every touchpoint, from the physical boarding pass to the projected score, speaks the same visual dialect.",
                      "lineHeight": "$type-body-sm-lh",
                      "fontFamily": "$font-body",
                      "fontSize": "$type-body-sm",
                      "fontWeight": "$type-weight-normal"
